# Application settings
APP_NAME=Laravel
APP_ENV=local
APP_URL=http://localhost

# Localization
APP_LOCALE=en

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database connection (Supabase - Example Only)
DB_CONNECTION=pgsql
DB_HOST=my-db-host.supabase.co
DB_PORT=5432
DB_DATABASE=my-database-name
DB_USERNAME=my-username
DB_PASSWORD=my-password

# Session and Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# Redis (if used)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Mail (for testing)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Vite integration
VITE_APP_NAME="${APP_NAME}"
